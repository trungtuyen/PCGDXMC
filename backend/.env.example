PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pcgdxmc
DB_SSL=true
DB_POOL_MAX=30
CORS_ORIGINS=https://trungtuyen.github.io
RATE_LIMIT_MAX=600

# Production bắt buộc dùng secret ngẫu nhiên dài; không commit giá trị thật.
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h

# Chỉ dùng cho thử nghiệm nếu chưa có JWT. Production nên để trống.
API_AUTH_TOKEN=
ALLOW_ANON_AGGREGATES=false

# Dùng một lần với: npm run create-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARS
ADMIN_DISPLAY_NAME=Quản trị hệ thống
ADMIN_ROLE=super_admin
ADMIN_PROVINCE_KEY=
ADMIN_COMMUNE_CODE=

# Benchmark: npm run loadtest
TARGET_URL=https://api.example.vn
AUTH_TOKEN=
CONCURRENCY=50
REQUESTS=2000
P95_LIMIT_MS=1500
SURVEY_YEAR=2026
